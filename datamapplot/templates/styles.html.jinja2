{# CSS dependencies and page styles #}
{# The widget theme: every widget style refers to these (see render_html's widget_theme). #}
<style>
  :root {
  {%- for name, value in widget_theme_vars.items() %}
    {{ name }}: {{ value }};
  {%- endfor %}
  }
</style>
{% for _, css_src in css_dependency_srcs.items() -%}
<style>
  {{ css_src | safe }}
</style>
{%- endfor %}
<style>
  body {
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: {{ page_background_color }};
    font-family: var(--dmp-font-family);
    color: var(--dmp-text-color);
  }
  /* Browsers don't let form controls inherit the page font. */
  button, input, select, textarea {
    font-family: inherit;
  }
  .container-box {
    margin: var(--dmp-panel-margin);
    padding: var(--dmp-panel-padding);
    border-radius: var(--dmp-panel-radius);
    line-height: 0.95;
    width: fit-content;
    height: fit-content;
    z-index: 2;
    backdrop-filter: blur(var(--dmp-panel-blur));
    background: var(--dmp-panel-background);
    box-shadow: var(--dmp-panel-shadow);
    position: relative;
    pointer-events: auto;
  }
  .more-opaque {
    backdrop-filter: blur(calc(2 * var(--dmp-panel-blur)));
    background-color: var(--dmp-panel-background-opaque);
  }
  #deck-container {
    width: 100vw;
    height: 100vh;  
  }
  #deck-container canvas {
    z-index: 1;
    background: {{ page_background_color }};
  }
  .deck-tooltip {
      {{ tooltip_css }}
  }
  {%- if enable_tap_inspect %}
  /* Sizes are in em so the whole card scales with its font-size, which
     tap_inspect.js bumps on pages rendered through a scaled-down mobile
     layout viewport (no viewport meta tag). */
  .tap-inspect-card {
    display: none;
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 36em;
    max-height: 50vh;
    max-height: 50dvh;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    box-sizing: border-box;
    padding: 1.1em 3.9em calc(1.1em + env(safe-area-inset-bottom)) 1.1em;
    border-radius: 1.1em 1.1em 0 0;
    z-index: 90;
    pointer-events: auto;
    font-size: 0.9em;
    font-family: {{ tooltip_font_family }};
    font-weight: {{ tooltip_font_weight }};
    color: var(--dmp-text-color);
    background-color: var(--dmp-panel-background-opaque);
    backdrop-filter: blur(calc(2 * var(--dmp-panel-blur)));
    box-shadow: var(--dmp-panel-shadow);
  }
  .tap-inspect-card.visible {
    display: block;
  }
  .tap-inspect-close {
    position: absolute;
    top: 0.3em;
    right: 0.3em;
    min-width: 3em;
    min-height: 3em;
    border: none;
    background: transparent;
    color: var(--dmp-text-color);
    font-size: 1.5em;
    line-height: 1;
    cursor: pointer;
  }
  .tap-inspect-action {
    display: block;
    margin-top: 0.85em;
    min-height: 3em;
    width: 100%;
    border-radius: 0.85em;
    border: none;
    background: var(--dmp-accent-color);
    color: var(--dmp-accent-text-color);
    font-family: inherit;
    font-size: 1em;
    font-weight: 600;
    cursor: pointer;
  }
  {%- endif %}
  input:not([type]), input[type="search"], input[type="text"], input[type="number"],
  textarea, select {
    margin: 2px;
    padding: 4px;
    border-radius: var(--dmp-control-radius);
    color: var(--dmp-text-color);
    background: var(--dmp-input-background);
    border: var(--dmp-input-border);
    transition: 0.5s;
    outline: none;
    box-sizing: border-box;
  }
  input:not([type]):focus, input[type="search"]:focus, input[type="text"]:focus,
  input[type="number"]:focus, textarea:focus, select:focus {
    border: var(--dmp-input-focus-border);
  }
  input[type="checkbox"], input[type="radio"], input[type="range"] {
    accent-color: var(--dmp-accent-color);
  }
  {%- if logo and not use_widget_system %}
  img {
    display: block;
    margin-left: auto;
    margin-right: auto;
  }
  #logo-container {
    position: absolute;
    right: 0;
    bottom: 0;
    margin: 8px 16px 8px 16px;
    z-index: 0;
  }
  {%- endif %}

  {%- if search %}
  #search-container{
    width: fit-content;
  }
  {%- endif %}
  
  {%- if custom_css %}
  {{ custom_css }}
  {%- endif %}
</style>
